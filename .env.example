# Required for AI Features (Vanna AI Chatbot and Data Enrichment)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Specify the model (defaults to qwen/qwen3.6-27b)
GROQ_MODEL=qwen/qwen3.6-27b

# (Production Only) Tell the backend where the frontend lives to allow CORS
FRONTEND_URL=https://your-app.vercel.app
